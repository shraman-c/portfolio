---
import { siteConfig } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

const features = [
  {
    title: "100% Local & Privacy-First",
    description: "All parsing and regex heuristics execute directly within your browser sandbox. Zero emails, headers, or metadata ever leave your client device."
  },
  {
    title: "Explainable Scoring Engine",
    description: "Every warning sign adds mathematically defined point weights (0–100). Replaces black-box machine learning with transparent, auditable indicators."
  },
  {
    title: "22 Rules across 7 Domains",
    description: "Comprehensive detection vectors covering urgency triggers, credential requests, financial BEC fraud, IP URLs, weaponized macros, and authentication mismatches."
  },
  {
    title: "Visual Risk Stratification",
    description: "Dynamically classifies emails into Low Risk (0–29), Suspicious (30–59), and High Risk (60–100) with visual telemetry meters and category summaries."
  },
  {
    title: "Actionable Defense Guidance",
    description: "Synthesizes tailored next-step security advice based on the exact threat vectors identified (e.g., verifying out-of-band, checking MX records)."
  },
  {
    title: "Interactive Training Scenarios",
    description: "Pre-loaded with 6 realistic training samples: obvious spam, sophisticated BEC, Microsoft 365 credential traps, package alerts, and verified legitimate mail."
  }
];

const scoringRules = [
  { category: "Social Engineering", rule: "Urgency and panic-inducing language", points: "+10" },
  { category: "Social Engineering", rule: "Immediate account closure or suspension threats", points: "+15" },
  { category: "Credential Harvesting", rule: "Direct password or credential entry requests", points: "+25" },
  { category: "Credential Harvesting", rule: "One-Time Password (OTP) or MFA code solicitations", points: "+25" },
  { category: "Financial Fraud", rule: "Wire transfer, gift card, or cryptocurrency demands", points: "+30" },
  { category: "Financial Fraud", rule: "Unsolicited bank account detail alteration notices", points: "+25" },
  { category: "Suspicious Links", rule: "Bare IP address URLs in hyperlinks", points: "+20" },
  { category: "Suspicious Links", rule: "URL shorteners (bit.ly, tinyurl, etc.) masking destinations", points: "+15" },
  { category: "Suspicious Links", rule: "Mismatched anchor text versus actual href destination", points: "+20" },
  { category: "Suspicious Links", rule: "Typosquatting and lookalike domain substitutions", points: "+20" },
  { category: "Dangerous Files", rule: "Executable attachments (.exe, .scr, .bat, .vbs)", points: "+30" },
  { category: "Authentication", rule: "Failed SPF / DKIM / DMARC or Reply-To address mismatch", points: "+20" }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="PhishAnalyser — Privacy-first, client-side phishing email triage and educational analysis tool. Runs entirely in your browser with zero data leakage."
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href="https://shramanc.pages.dev/phish-analyser" />
    <title>PhishAnalyser — Privacy-First Phishing Detection</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@500&family=Reddit+Sans+Condensed:wght@900&display=swap"
      rel="stylesheet"
    />
    <!-- Open Graph Tags -->
    <meta property="og:title" content="PhishAnalyser — Privacy-First Phishing Detection" />
    <meta property="og:description" content="Client-side educational triage tool for identifying phishing indicators in emails with transparent scoring." />
    <meta property="og:url" content="https://shramanc.pages.dev/phish-analyser/" />
  </head>
  <body class="bg-concrete text-obsidian">
    <Header />

    <!-- Hero Section -->
    <main class="relative py-32 flex items-center justify-center min-h-[70vh]">
      <!-- Diagonal wash of light -->
      <div
        class="absolute top-0 right-0 w-[60%] h-full -z-10 pointer-events-none"
        style="background: radial-gradient(circle at 100% 0%, var(--color-solar-beam) 0%, transparent 60%); opacity: 0.25; filter: blur(40px);"
      ></div>

      <div class="mx-auto max-w-4xl px-6 lg:px-8 text-center flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-paper-white border border-silver/50 rounded-buttons mb-8 select-none shadow-subtle">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-solar-beam opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-solar-beam"></span>
          </span>
          <span class="font-inter font-medium text-caption text-graphite">Client-Side Cybersecurity Triage</span>
        </div>
        
        <h1 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none mb-6">
          PHISHANALYSER
        </h1>
        
        <p class="font-inter-display font-medium text-body text-graphite mb-10 leading-relaxed max-w-2xl">
          A privacy-first educational tool for inspecting and learning to identify phishing emails. Runs entirely in your browser with zero network requests and an explainable, transparent scoring engine.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a 
            href="https://github.com/shraman-c/PhishAnalyser" 
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-2.5 bg-solar-beam text-black border border-solar-beam rounded-buttons font-inter font-medium text-body-sm hover:bg-obsidian hover:text-concrete hover:border-obsidian transition-colors duration-200 cursor-pointer flex items-center justify-center gap-2"
          >
            <span>View on GitHub</span>
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
          <a 
            href="#rules" 
            class="px-6 py-2.5 bg-paper-white text-obsidian border border-silver/50 rounded-buttons font-inter font-medium text-body-sm hover:bg-solar-beam hover:text-black hover:border-solar-beam transition-colors duration-200 cursor-pointer"
          >
            Detection Rules
          </a>
          <a 
            href="/" 
            class="px-6 py-2.5 bg-paper-white text-obsidian border border-silver/50 rounded-buttons font-inter font-medium text-body-sm hover:bg-solar-beam hover:text-black hover:border-solar-beam transition-colors duration-200 cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Back to Portfolio</span>
          </a>
        </div>
      </div>
    </main>

    <!-- Key Capabilities Section -->
    <section id="features" class="py-24 px-8 sm:px-12 md:px-24 border-t border-silver/30 bg-concrete flex flex-col items-center text-center">
      <div class="w-full max-w-[1200px] flex flex-col items-center">
        <!-- Section Title Block -->
        <div class="flex flex-col items-center mb-16">
          <span class="font-caveat text-graphite text-[28px] tracking-tight mb-2 select-none">
            Deterministic Heuristics
          </span>
          <h2 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none">
            ENGINE CAPABILITIES
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full text-left">
          {features.map((feature, i) => (
            <div class="group bg-paper-white p-8 sm:p-10 rounded-cards border border-silver/50 shadow-subtle hover:border-silver transition-all duration-300">
              <span class="font-inter font-medium text-caption text-ash block mb-4">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="font-inter font-medium text-subheading text-obsidian mb-3">
                {feature.title}
              </h3>
              <p class="font-inter-display font-medium text-body text-graphite leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Detection Rules & Scoring Matrix Section -->
    <section id="rules" class="py-24 px-8 sm:px-12 md:px-24 border-t border-silver/30 bg-paper-white flex flex-col items-center text-center">
      <div class="w-full max-w-[1200px] flex flex-col items-center">
        <!-- Section Title Block -->
        <div class="flex flex-col items-center mb-16">
          <span class="font-caveat text-graphite text-[28px] tracking-tight mb-2 select-none">
            Transparent Heuristics
          </span>
          <h2 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none">
            SCORING MATRIX
          </h2>
        </div>

        <div class="w-full overflow-x-auto text-left">
          <table class="w-full font-inter text-body-sm border-collapse bg-concrete rounded-cards border border-silver/50 overflow-hidden shadow-subtle">
            <thead>
              <tr class="border-b border-silver/40 text-ash text-caption uppercase bg-concrete">
                <th class="py-4 px-6">Attack Category</th>
                <th class="py-4 px-6">Heuristic Detection Pattern</th>
                <th class="py-4 px-6 text-right">Risk Weight</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-silver/20 text-graphite">
              {scoringRules.map((rule) => (
                <tr class="hover:bg-silver/10 transition-colors">
                  <td class="py-4 px-6 font-medium text-obsidian">
                    <span class="px-3 py-1 bg-paper-white text-obsidian rounded-buttons text-caption border border-silver/40 font-medium">
                      {rule.category}
                    </span>
                  </td>
                  <td class="py-4 px-6 text-obsidian">{rule.rule}</td>
                  <td class="py-4 px-6 font-mono text-xs font-bold text-obsidian text-right">{rule.points}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Architecture & Privacy Section -->
    <section class="py-24 px-8 sm:px-12 md:px-24 border-t border-silver/30 bg-concrete flex flex-col items-center text-center">
      <div class="w-full max-w-[1200px] flex flex-col items-center">
        <!-- Section Title Block -->
        <div class="flex flex-col items-center mb-16">
          <span class="font-caveat text-graphite text-[28px] tracking-tight mb-2 select-none">
            Zero Network Leakage
          </span>
          <h2 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none">
            HOW IT WORKS
          </h2>
        </div>

        <div class="w-full text-left bg-paper-white p-8 sm:p-10 rounded-cards border border-silver/50 shadow-subtle">
          <h3 class="font-inter font-medium text-subheading text-obsidian mb-4">Client-Side Analysis Pipeline</h3>
          <p class="font-inter-display font-medium text-body text-graphite mb-6 leading-relaxed">
            Unlike online scanner APIs that store email contents on external servers, PhishAnalyser operates entirely in-memory:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-inter text-body-sm text-graphite">
            <div class="p-6 bg-concrete rounded-cards border border-silver/40">
              <span class="font-mono text-xs text-ash uppercase font-semibold block mb-2">Step 01</span>
              <h4 class="font-medium text-obsidian text-subheading mb-2">RFC Header Extraction</h4>
              <p class="text-caption">Deconstructs Return-Path, Received hops, SPF/DKIM authentication outcomes, and Reply-To discrepancies.</p>
            </div>
            <div class="p-6 bg-concrete rounded-cards border border-silver/40">
              <span class="font-mono text-xs text-ash uppercase font-semibold block mb-2">Step 02</span>
              <h4 class="font-medium text-obsidian text-subheading mb-2">Lexical &amp; URL Heuristics</h4>
              <p class="text-caption">Parses anchor tags, IP formats, suspicious TLDs, urgent call-to-actions, and credential solicitation triggers.</p>
            </div>
            <div class="p-6 bg-concrete rounded-cards border border-silver/40">
              <span class="font-mono text-xs text-ash uppercase font-semibold block mb-2">Step 03</span>
              <h4 class="font-medium text-obsidian text-subheading mb-2">Scoring &amp; Triage</h4>
              <p class="text-caption">Aggregates transparent weights, displays risk stratification meters, and issues context-aware defenses.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack Section -->
    <section class="py-24 px-8 sm:px-12 md:px-24 border-t border-silver/30 bg-concrete flex flex-col items-center text-center">
      <div class="w-full max-w-[1200px] flex flex-col items-center">
        <!-- Section Title Block -->
        <div class="flex flex-col items-center mb-16">
          <span class="font-caveat text-graphite text-[28px] tracking-tight mb-2 select-none">
            Technologies &amp; Architecture
          </span>
          <h2 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none">
            TECH STACK
          </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 w-full">
          {["Vanilla JS", "Regex Parser", "HTML5 Canvas", "Cybersecurity", "Client Sandbox", "Zero Dep"].map((tech) => (
            <div class="bg-paper-white p-6 rounded-cards border border-silver/50 text-center shadow-subtle hover:border-silver transition-colors duration-300">
              <span class="font-inter font-medium text-subheading text-obsidian block">
                {tech}
              </span>
            </div>
          ))}
        </div>

        <div class="mt-16 flex flex-wrap gap-4 justify-center">
          <a
            href="https://github.com/shraman-c/PhishAnalyser"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-2.5 bg-solar-beam text-black border border-solar-beam rounded-buttons font-inter font-medium text-body-sm hover:bg-obsidian hover:text-concrete hover:border-obsidian transition-colors duration-200 cursor-pointer flex items-center justify-center gap-2"
          >
            <span>View Source on GitHub</span>
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
          <a
            href="/"
            class="px-6 py-2.5 bg-paper-white text-obsidian border border-silver/50 rounded-buttons font-inter font-medium text-body-sm hover:bg-solar-beam hover:text-black hover:border-solar-beam transition-colors duration-200 cursor-pointer"
          >
            Back to Portfolio
          </a>
        </div>
      </div>
    </section>

    <Footer />
    <ThemeToggle />
  </body>
</html>
