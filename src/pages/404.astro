---
import Header from "../components/Header.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>404: Not Found - {siteConfig.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@500&family=Reddit+Sans+Condensed:wght@900&display=swap"
      rel="stylesheet"
    />
    <!-- Open Graph Tags for LinkedIn/Social Previews -->
    <meta property="og:title" content={`404: Not Found - ${siteConfig.name}`} />
    <meta property="og:description" content="" />
    <meta property="og:url" content="https://shramanc.pages.dev/404/" />
    <!-- Optional: Add a screenshot link if you have one -->
    <!-- <meta property="og:image" content="https://shramanc.pages.dev/404/preview.png" /> -->
    </head>
  <body class="flex flex-col min-h-screen bg-[var(--background)] text-[var(--foreground)]">
    <Header />
    <main class="flex-grow flex items-center justify-center py-20 px-4">
      <div class="text-center">
        <h1 class="text-obsidian font-reddit-sans-condensed font-black text-display uppercase select-none mb-2">404</h1>
        <h2 class="text-obsidian font-reddit-sans-condensed font-black text-heading uppercase mb-4">Page Not Found</h2>
        <p class="text-graphite font-inter-display font-medium text-body mb-8 max-w-md mx-auto">
          The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
        </p>
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-6 py-2.5 bg-solar-beam text-black rounded-buttons font-inter font-medium text-body-sm border border-solar-beam hover:bg-obsidian hover:text-concrete hover:border-obsidian transition-colors duration-200 cursor-pointer"
        >
          Return Home
        </a>
      </div>
    </main>
    <Footer />
    <ThemeToggle />
  </body>
</html>
