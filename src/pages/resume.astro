---
import { siteConfig } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

const cvLink = siteConfig.cvLink && siteConfig.cvLink !== "#" ? siteConfig.cvLink : "#";
const hasCvLink = cvLink !== "#";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Resume & CV of ${siteConfig.name}`} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href="https://shramanc.pages.dev/resume" />
    <title>Resume & CV - {siteConfig.name}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@500&family=Reddit+Sans+Condensed:wght@900&display=swap"
      rel="stylesheet"
    />
    <!-- Open Graph Tags for LinkedIn/Social Previews -->
    <meta property="og:title" content={`Resume & CV - ${siteConfig.name}`} />
    <meta property="og:description" content={`Resume and Curriculum Vitae of ${siteConfig.name}`} />
    <meta property="og:url" content="https://shramanc.pages.dev/resume/" />
    <!-- Optional: Add a screenshot link if you have one -->
    <!-- <meta property="og:image" content="https://shramanc.pages.dev/resume/preview.png" /> -->
    </head>
  <body class="bg-concrete min-h-screen md:h-screen flex flex-col justify-between overflow-x-hidden md:overflow-hidden">
    <Header />

    <main class="relative isolate overflow-hidden bg-concrete flex-1 flex items-center justify-center pt-20 sm:pt-24 pb-4 px-4 sm:px-6">
      <!-- Solar Beam Gradient cutting from upper-right to lower-left -->
      <div
        class="absolute top-0 right-0 w-[80%] h-full -z-10 pointer-events-none"
        style="background: radial-gradient(circle at 100% 0%, var(--color-solar-beam) 0%, transparent 60%); opacity: 0.35; filter: blur(40px);"
      ></div>
      <div
        class="absolute top-0 right-0 w-full h-full -z-20 pointer-events-none"
        style="background: linear-gradient(225deg, rgba(255, 213, 0, 0.15) 0%, transparent 50%);"
      ></div>

      <div class="w-full max-w-3xl px-2 sm:px-4 relative z-10 my-auto">
        <div class="bg-paper-white rounded-cards border border-silver/50 p-5 sm:p-7 md:p-8 text-center shadow-subtle flex flex-col items-center">
          <span class="font-caveat text-graphite text-[20px] sm:text-[24px] tracking-tight mb-1 select-none">
            Credentials & Experience
          </span>
          <h1 class="font-reddit-sans-condensed font-black text-[30px] sm:text-[42px] text-obsidian tracking-tighter uppercase select-none mb-1">
            Resume & CV
          </h1>
          <p class="font-inter-display font-medium text-caption sm:text-body-sm md:text-body text-graphite mb-4 sm:mb-6 leading-relaxed max-w-lg">
            Choose between a concise overview resume or the comprehensive curriculum vitae.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 w-full text-center">
            <!-- Resume Card -->
            <div class="flex flex-col justify-between items-center p-4 sm:p-5 rounded-2xl bg-concrete/60 border border-silver/40 hover:border-silver transition-all duration-200 text-center">
              <div class="flex flex-col items-center">
                <h2 class="font-reddit-sans-condensed font-bold text-xl sm:text-2xl uppercase tracking-tight text-obsidian mb-1">
                  Resume
                </h2>
                <p class="text-caption sm:text-body-sm font-inter text-graphite mb-4 leading-relaxed">
                  A concise summary of technical experience, core projects, key skills, and education.
                </p>
              </div>
              <a
                href={siteConfig.resumeLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-2 sm:py-2.5 bg-paper-white text-obsidian rounded-buttons font-inter font-medium text-body-sm border border-silver/50 hover:bg-solar-beam hover:text-black hover:border-solar-beam transition-colors duration-200 cursor-pointer w-full text-center"
              >
                <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" x2="8" y1="13" y2="13"/>
                  <line x1="16" x2="8" y1="17" y2="17"/>
                  <line x1="10" x2="8" y1="9" y2="9"/>
                </svg>
                <span>Open in Google Drive</span>
              </a>
            </div>

            <!-- CV Card -->
            <div class="flex flex-col justify-between items-center p-4 sm:p-5 rounded-2xl bg-concrete/60 border border-silver/40 hover:border-silver transition-all duration-200 text-center">
              <div class="flex flex-col items-center">
                <h2 class="font-reddit-sans-condensed font-bold text-xl sm:text-2xl uppercase tracking-tight text-obsidian mb-1">
                  Curriculum Vitae
                </h2>
                <p class="text-caption sm:text-body-sm font-inter text-graphite mb-4 leading-relaxed">
                  A fuller record of education, technical projects, skills, certifications, achievements, leadership, event coordination, and volunteering.
                </p>
              </div>
              <a
                href={cvLink}
                target={hasCvLink ? "_blank" : undefined}
                rel={hasCvLink ? "noopener noreferrer" : undefined}
                class="inline-flex items-center justify-center gap-2 px-5 py-2 sm:py-2.5 bg-solar-beam text-black rounded-buttons font-inter font-medium text-body-sm border border-solar-beam hover:bg-obsidian hover:text-concrete hover:border-obsidian transition-colors duration-200 cursor-pointer w-full text-center"
              >
                <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" x2="12" y1="15" y2="3"/>
                </svg>
                <span>Download CV</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </main>

    <Footer compact={true} />
    <ThemeToggle />
  </body>
</html>
