---
import { siteConfig } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Resume of ${siteConfig.name}`} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href="https://shramanc.pages.dev/resume" />
    <title>Resume - {siteConfig.name}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@500&family=Reddit+Sans+Condensed:wght@900&display=swap"
      rel="stylesheet"
    />
    <!-- Open Graph Tags for LinkedIn/Social Previews -->
    <meta property="og:title" content={`Resume - ${siteConfig.name}`} />
    <meta property="og:description" content={`Resume of ${siteConfig.name}`} />
    <meta property="og:url" content="https://shramanc.pages.dev/resume/" />
    <!-- Optional: Add a screenshot link if you have one -->
    <!-- <meta property="og:image" content="https://shramanc.pages.dev/resume/preview.png" /> -->
    </head>
  <body class="bg-concrete">
    <Header />

    <main class="min-h-screen py-32 flex items-center justify-center">
      <div class="w-full px-6">
        <div class="max-w-2xl mx-auto bg-paper-white rounded-cards border border-silver/50 p-8 sm:p-12 text-center shadow-subtle flex flex-col items-center">
          <h1 class="font-reddit-sans-condensed font-black text-[40px] sm:text-[60px] text-obsidian tracking-tighter uppercase select-none mb-4">
            My Resume
          </h1>
          <p class="font-inter-display font-medium text-body text-graphite mb-10 leading-relaxed max-w-lg">
            You can view or download my latest resume from Google Drive using the link below.
          </p>
          <a
            href={siteConfig.resumeLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-2.5 bg-solar-beam text-black rounded-buttons font-inter font-medium text-body-sm border border-solar-beam hover:bg-obsidian hover:text-concrete hover:border-obsidian transition-colors duration-200 cursor-pointer mb-8"
          >
            <svg class="w-5 h-5 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
            <span>Open in Google Drive</span>
          </a>

        </div>
      </div>
    </main>

    <Footer />
    <ThemeToggle />
  </body>
</html>
