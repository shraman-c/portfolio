---
import { siteConfig } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";

const features = [
  {
    title: "Secure HR Access",
    description: "Email verification, JWT-based authentication, and encrypted credential handling keep employee and admin access secure."
  },
  {
    title: "Role-Based Portals",
    description: "Separate employee and admin dashboards with permissions tailored to the workflows each role needs most."
  },
  {
    title: "Profile & Document Management",
    description: "Employees can manage personal profiles, uploads, and key documentation from a centralized workspace."
  },
  {
    title: "Attendance Workflow",
    description: "Track check-in and check-out activity, monitor attendance trends, and simplify daily operations."
  },
  {
    title: "Leave Approvals",
    description: "Create leave requests, route them through approval flows, and keep records transparent for HR teams."
  },
  {
    title: "Payroll Visibility",
    description: "Expose salary and payroll information in a clean, accessible experience for employees and administrators alike."
  }
];

const techStack = ["Next.js", "React", "TypeScript", "Tailwind CSS", "Prisma", "PostgreSQL", "JWT", "bcryptjs", "Nodemailer", "SMTP"];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="WorkFrame is a full-stack Human Resource Management System built with Next.js, Prisma, and PostgreSQL for secure attendance, leave, payroll, and employee workflows."
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href="https://shramanc.pages.dev/workframe" />
    <title>WorkFrame — Human Resource Management System</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://shramanc.pages.dev/workframe" />
    <meta property="og:title" content="WorkFrame — Human Resource Management System" />
    <meta
      property="og:description"
      content="WorkFrame is a full-stack Human Resource Management System built with Next.js, Prisma, and PostgreSQL for secure attendance, leave, payroll, and employee workflows."
    />
    <meta property="og:image" content="https://shramanc.pages.dev/images/workframe/workframe-employees.png" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://shramanc.pages.dev/workframe" />
    <meta property="twitter:title" content="WorkFrame — Human Resource Management System" />
    <meta
      property="twitter:description"
      content="WorkFrame is a full-stack Human Resource Management System built with Next.js, Prisma, and PostgreSQL for secure attendance, leave, payroll, and employee workflows."
    />
    <meta property="twitter:image" content="https://shramanc.pages.dev/images/workframe/workframe-employees.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Inter:wght@500&family=Reddit+Sans+Condensed:wght@900&display=swap"
      rel="stylesheet"
    />
    <!-- Open Graph Tags for LinkedIn/Social Previews -->
    <meta property="og:title" content="WorkFrame — Human Resource Management System" />
    <meta property="og:description" content="WorkFrame is a full-stack Human Resource Management System built with Next.js, Prisma, and PostgreSQL for secure attendance, leave, payroll, and employee workflows." />
    <meta property="og:url" content="https://shramanc.pages.dev/workframe/" />
    </head>
  <body class="bg-concrete text-obsidian">
    <Header />

    <main class="relative py-32 flex items-center justify-center min-h-[70vh]">
      <div
        class="absolute top-0 right-0 w-[60%] h-full -z-10 pointer-events-none"
        style="background: radial-gradient(circle at 100% 0%, var(--color-solar-beam) 0%, transparent 60%); opacity: 0.25; filter: blur(40px);"
      ></div>

      <div class="mx-auto max-w-4xl px-6 lg:px-8 text-center flex flex-col items-center">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-paper-white border border-silver/50 rounded-buttons mb-8 select-none shadow-subtle">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-solar-beam opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-solar-beam"></span>
          </span>
          <span class="font-inter font-medium text-caption text-graphite">HR Operations Platform</span>
        </div>

        <h1 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none mb-6">
          WORKFRAME
        </h1>

        <p class="font-inter-display font-medium text-body text-graphite mb-10 leading-relaxed max-w-2xl">
          A full-stack Human Resource Management System designed to streamline employee self-service, attendance monitoring, leave approvals, payroll visibility, and secure administration.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="https://work-frame-lake.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-2.5 bg-solar-beam text-black rounded-buttons font-inter font-medium text-body-sm border border-solar-beam hover:bg-obsidian hover:text-concrete hover:border-obsidian transition-colors duration-200 cursor-pointer flex items-center justify-center gap-2"
          >
            <span>View Live Demo</span>
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <a
            href="#gallery"
            class="px-6 py-2.5 bg-paper-white text-obsidian rounded-buttons font-inter font-medium text-body-sm border border-silver/50 hover:bg-solar-beam hover:text-black hover:border-solar-beam transition-colors duration-200 cursor-pointer"
          >
            App Previews
          </a>
          <a
            href="#features"
            class="px-6 py-2.5 bg-paper-white text-obsidian rounded-buttons font-inter font-medium text-body-sm border border-silver/50 hover:bg-solar-beam hover:text-black hover:border-solar-beam transition-colors duration-200 cursor-pointer"
          >
            Explore Features
          </a>
          <a
            href="https://github.com/shraman-c/WorkFrame"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-2.5 bg-paper-white text-obsidian rounded-buttons font-inter font-medium text-body-sm border border-silver/50 hover:bg-solar-beam hover:text-black hover:border-solar-beam transition-colors duration-200 cursor-pointer flex items-center justify-center gap-2"
          >
            <span>GitHub</span>
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
        </div>
      </div>
    </main>

    <!-- App Previews / Screenshot Gallery Section -->
    <section id="gallery" class="py-24 px-8 sm:px-12 md:px-24 border-t border-silver/30 bg-concrete flex flex-col items-center text-center">
      <div class="w-full max-w-[1200px] flex flex-col items-center">
        <div class="flex flex-col items-center mb-16">
          <span class="font-caveat text-graphite text-[28px] tracking-tight mb-2 select-none">
            Interface Walkthrough
          </span>
          <h2 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none">
            APP PREVIEWS
          </h2>
        </div>

        <!-- Featured Primary Screenshot: Employee Management -->
        <div class="w-full mb-8">
          <div class="bg-paper-white rounded-cards border border-silver/50 shadow-subtle overflow-hidden">
            <div class="p-5 border-b border-silver/30 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-left">
              <div>
                <span class="font-inter font-medium text-caption text-solar-beam uppercase tracking-wider block">Admin &amp; HR Portal</span>
                <h3 class="font-inter font-medium text-subheading text-obsidian">Employee Directory &amp; Headcount Management</h3>
              </div>
              <span class="inline-flex items-center px-3 py-1 bg-concrete text-graphite rounded-buttons text-caption font-inter font-medium border border-silver/40 self-start sm:self-auto">
                Live Overview
              </span>
            </div>
            <img
              src="/images/workframe/workframe-employees.png"
              alt="WorkFrame employee directory with active department filters, headcount summary, and employee roster cards"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
            <p class="font-inter-display font-medium text-body-sm text-graphite py-4 px-6 italic text-left">
              Role-based employee roster with live attendance counts, department filtering, and quick actions.
            </p>
          </div>
        </div>

        <!-- Secondary Grid of Screenshots (2 columns) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full text-left">
          <!-- Time Off / Leave Calendar -->
          <div class="bg-paper-white rounded-cards border border-silver/50 shadow-subtle overflow-hidden flex flex-col">
            <div class="p-5 border-b border-silver/30">
              <span class="font-inter font-medium text-caption text-solar-beam uppercase tracking-wider block">Leave Workflows</span>
              <h3 class="font-inter font-medium text-subheading text-obsidian">Annual Leave &amp; Time Off Calendar</h3>
            </div>
            <img
              src="/images/workframe/workframe-time-off.png"
              alt="WorkFrame annual leave calendar showing validated, pending, and refused time off requests"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
            <p class="font-inter-display font-medium text-body-sm text-graphite py-4 px-6 italic mt-auto">
              12-month interactive leave calendar with paid and sick day balance tracking and color-coded statuses.
            </p>
          </div>

          <!-- Activity Log / Audit Trail -->
          <div class="bg-paper-white rounded-cards border border-silver/50 shadow-subtle overflow-hidden flex flex-col">
            <div class="p-5 border-b border-silver/30">
              <span class="font-inter font-medium text-caption text-solar-beam uppercase tracking-wider block">Security &amp; Compliance</span>
              <h3 class="font-inter font-medium text-subheading text-obsidian">Admin Activity Audit Trail</h3>
            </div>
            <img
              src="/images/workframe/workframe-activity-log.png"
              alt="WorkFrame admin activity log tracking user sign-ins, leave approvals, salary structure changes, and payslips"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
            <p class="font-inter-display font-medium text-body-sm text-graphite py-4 px-6 italic mt-auto">
              Real-time audit log recording every actor event, payslip download, login attempt, and leave change.
            </p>
          </div>

          <!-- Employee Clock-In View -->
          <div class="bg-paper-white rounded-cards border border-silver/50 shadow-subtle overflow-hidden flex flex-col">
            <div class="p-5 border-b border-silver/30">
              <span class="font-inter font-medium text-caption text-solar-beam uppercase tracking-wider block">Employee Self-Service</span>
              <h3 class="font-inter font-medium text-subheading text-obsidian">Daily Clock-In &amp; Attendance Status</h3>
            </div>
            <img
              src="/images/workframe/workframe-attendance-clockin.png"
              alt="WorkFrame employee clock in view with live check-in confirmation and check-out drawer"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
            <p class="font-inter-display font-medium text-body-sm text-graphite py-4 px-6 italic mt-auto">
              Personalized employee dashboard with active session timer, daily status badge, and monthly summary.
            </p>
          </div>

          <!-- Admin Attendance Tracking -->
          <div class="bg-paper-white rounded-cards border border-silver/50 shadow-subtle overflow-hidden flex flex-col">
            <div class="p-5 border-b border-silver/30">
              <span class="font-inter font-medium text-caption text-solar-beam uppercase tracking-wider block">Managerial Overview</span>
              <h3 class="font-inter font-medium text-subheading text-obsidian">Attendance Log &amp; Hours Tracking</h3>
            </div>
            <img
              src="/images/workframe/workframe-attendance-admin.png"
              alt="WorkFrame centralized attendance monitoring table showing daily work hours and check-out logs"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
            <p class="font-inter-display font-medium text-body-sm text-graphite py-4 px-6 italic mt-auto">
              Comprehensive attendance tracking table with date ranges, work hours calculation, and status indicators.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="py-24 px-8 sm:px-12 md:px-24 border-t border-silver/30 bg-concrete flex flex-col items-center text-center">
      <div class="w-full max-w-[1200px] flex flex-col items-center">
        <div class="flex flex-col items-center mb-16">
          <span class="font-caveat text-graphite text-[28px] tracking-tight mb-2 select-none">
            Built for smarter teams
          </span>
          <h2 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none">
            FEATURES
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full text-left">
          {features.map((feature) => (
            <div class="group bg-paper-white p-8 sm:p-10 rounded-cards border border-silver/50 shadow-subtle hover:border-silver transition-all duration-300">
              <h3 class="font-inter font-medium text-subheading text-obsidian mb-3">
                {feature.title}
              </h3>
              <p class="font-inter-display font-medium text-body text-graphite leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 px-8 sm:px-12 md:px-24 border-t border-silver/30 bg-concrete flex flex-col items-center text-center">
      <div class="w-full max-w-[1200px] flex flex-col items-center">
        <div class="flex flex-col items-center mb-16">
          <span class="font-caveat text-graphite text-[28px] tracking-tight mb-2 select-none">
            Built for daily operations
          </span>
          <h2 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none">
            PLATFORM HIGHLIGHTS
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 w-full text-left">
          <div class="bg-paper-white p-8 sm:p-10 rounded-cards border border-silver/50 shadow-subtle hover:border-silver transition-colors duration-300">
            <h3 class="font-inter font-medium text-subheading text-obsidian mb-3">Employee Self-Service</h3>
            <p class="font-inter-display font-medium text-body text-graphite leading-relaxed">
              Employees can manage profiles, access payroll data, and submit HR requests without depending on manual admin follow-ups.
            </p>
          </div>

          <div class="bg-paper-white p-8 sm:p-10 rounded-cards border border-silver/50 shadow-subtle hover:border-silver transition-colors duration-300">
            <h3 class="font-inter font-medium text-subheading text-obsidian mb-3">Admin Control Center</h3>
            <p class="font-inter-display font-medium text-body text-graphite leading-relaxed">
              HR administrators can review attendance, approve leave, and keep business-critical workflows running smoothly.
            </p>
          </div>

          <div class="bg-paper-white p-8 sm:p-10 rounded-cards border border-silver/50 shadow-subtle hover:border-silver transition-colors duration-300">
            <h3 class="font-inter font-medium text-subheading text-obsidian mb-3">Audit-Friendly</h3>
            <p class="font-inter-display font-medium text-body text-graphite leading-relaxed">
              Notifications and audit logging help teams track actions, support accountability, and maintain operational transparency.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 px-8 sm:px-12 md:px-24 border-t border-silver/30 bg-concrete flex flex-col items-center text-center">
      <div class="w-full max-w-[1200px] flex flex-col items-center">
        <div class="flex flex-col items-center mb-16">
          <span class="font-caveat text-graphite text-[28px] tracking-tight mb-2 select-none">
            Technologies in use
          </span>
          <h2 class="text-obsidian font-reddit-sans-condensed font-black text-display leading-none tracking-tighter uppercase select-none">
            TECH STACK
          </h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 w-full">
          {techStack.map((tech) => (
            <div class="bg-paper-white p-6 rounded-cards border border-silver/50 text-center shadow-subtle hover:border-silver transition-colors duration-300">
              <p class="font-inter font-medium text-body-sm text-obsidian select-none">{tech}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 px-8 sm:px-12 md:px-24 border-t border-silver/30 bg-concrete flex flex-col items-center text-center">
      <div class="w-full max-w-4xl flex flex-col items-center">
        <div class="bg-paper-white p-12 rounded-cards border border-silver/50 w-full shadow-subtle">
          <h2 class="font-reddit-sans-condensed font-black text-heading-lg text-obsidian uppercase select-none mb-6">
            Ready to streamline HR workflows?
          </h2>
          <p class="font-inter-display font-medium text-body text-graphite mb-10 leading-relaxed max-w-xl mx-auto">
            WorkFrame brings secure access, role-based operations, and employee-first automation together in one modern HR platform.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://work-frame-lake.vercel.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-2.5 bg-solar-beam text-black border border-solar-beam rounded-buttons font-inter font-medium text-body-sm hover:bg-obsidian hover:text-concrete hover:border-obsidian transition-colors duration-200 cursor-pointer"
            >
              Try the Demo
            </a>
            <a
              href={siteConfig.social.email ? `mailto:${siteConfig.social.email}?subject=WorkFrame Inquiry` : "#"}
              class="px-6 py-2.5 bg-concrete text-obsidian border border-silver/50 rounded-buttons font-inter font-medium text-body-sm hover:bg-solar-beam hover:text-black hover:border-solar-beam transition-colors duration-200 cursor-pointer"
            >
              Contact
            </a>
            <a
              href="/"
              class="px-6 py-2.5 bg-concrete text-obsidian border border-silver/50 rounded-buttons font-inter font-medium text-body-sm hover:bg-solar-beam hover:text-black hover:border-solar-beam transition-colors duration-200 cursor-pointer"
            >
              Back to Portfolio
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer />
    <ThemeToggle />
  </body>
</html>
