---
// ThemeToggle.astro
---

<button
  id="theme-switcher"
  class="theme-switcher-btn fixed bottom-8 right-8 z-50 cursor-pointer shadow-subtle select-none transition-all duration-300"
  aria-label="Toggle Theme"
>
  <!-- Sliding indicator background: exact 32px x 32px circle -->
  <span id="theme-indicator" class="theme-indicator"></span>
  
  <!-- Sun icon slot: exact 32px x 32px -->
  <span id="sun-icon-span" class="theme-icon-slot">
    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="5"></circle>
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
    </svg>
  </span>

  <!-- Moon icon slot: exact 32px x 32px -->
  <span id="moon-icon-span" class="theme-icon-slot">
    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
</button>

<style>
  .theme-switcher-btn {
    position: fixed;
    bottom: 32px;
    right: 32px;
    width: 80px;
    height: 42px;
    padding: 5px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #1f1f1f;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 9999px;
    z-index: 50;
  }

  .theme-indicator {
    position: absolute;
    top: 5px;
    left: 5px;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background-color: #ffd500;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 1;
  }

  .theme-icon-slot {
    position: relative;
    z-index: 2;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: color 0.3s ease;
  }

  .theme-icon-slot svg {
    display: block;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
</style>

<script>
  // @ts-nocheck
  (function() {
    const root = document.documentElement;
    const switcher = document.getElementById('theme-switcher');
    const indicator = document.getElementById('theme-indicator');
    const sunSpan = document.getElementById('sun-icon-span');
    const moonSpan = document.getElementById('moon-icon-span');
    const STORAGE_KEY = 'theme-daniel-sun';

    function getTheme() {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored === 'dark' || stored === 'light') return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function applyTheme(theme) {
      if (theme === 'dark') {
        root.setAttribute('data-theme', 'dark');
        indicator.style.transform = 'translateX(38px)';
        sunSpan.style.color = '#a3a3a3';
        moonSpan.style.color = '#000000';
      } else {
        root.setAttribute('data-theme', 'light');
        indicator.style.transform = 'translateX(0px)';
        sunSpan.style.color = '#000000';
        moonSpan.style.color = '#a3a3a3';
      }
      localStorage.setItem(STORAGE_KEY, theme);
    }

    // Toggle logic
    switcher?.addEventListener('click', () => {
      const current = root.getAttribute('data-theme') || 'light';
      const nextTheme = current === 'dark' ? 'light' : 'dark';
      applyTheme(nextTheme);
    });

    // Initialize state
    const initialTheme = getTheme();
    applyTheme(initialTheme);
  })();
</script>
